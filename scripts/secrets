#!/usr/bin/env bash
# Move secrets out of one local file and into the two places that need them.
#
# There is one file to fill in and one file to keep in a password vault:
# secrets.env, gitignored, documented by the tracked secrets.env.example. This
# script is what sends its contents onward, and it sends them to two different
# destinations on purpose:
#
#   push      the deploy group  -> GitHub repository secrets
#   install   everything else   -> config.toml on the server, mode 600, and a
#                                  restart, because a config that is not what
#                                  the process is running is not installed
#
# Runtime secrets deliberately never reach GitHub. Continuous deployment needs
# exactly enough to log in and restart a binary; it has no business holding a
# Stripe live key. If the CD path is ever compromised the damage should stop at
# "can deploy code", which is bad enough without also being "can charge cards".
#
# A value is never printed. `check` reports which keys are missing by name and
# says nothing whatsoever about the ones that are present -- discovering a
# missing secret one at a time, five minutes apart, is a bad afternoon, and a
# script that echoes a key into a terminal or a CI log is a rotation.
#
# This is a script rather than Makefile recipes because make runs recipes with
# /bin/sh, which on Debian is dash, and dash has no `set -o pipefail` -- the
# same reason scripts/go-test exists.
set -euo pipefail

readonly REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly ENV_FILE="${SECRETS_ENV:-$REPO_DIR/secrets.env}"

# MODE decides which pair of Stripe keys `render` and `install` write, and
# nothing else. Set from the argument by the dispatcher; see render_config.
MODE=default
readonly APP=dropin-forms

log() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!!\033[0m %s\n' "$*" >&2; }
die() {
	printf '\033[31mxx\033[0m %s\n' "$*" >&2
	exit 1
}

# Keys the current binary and the current deploy actually use. Both lists grow
# as the service does, and keeping them here rather than in a comment is what
# makes `check` tell the truth.
readonly REQUIRED_DEPLOY=(
	DEPLOY_SSH_HOST
	DEPLOY_SSH_USER
	DEPLOY_SSH_PORT
	DEPLOY_SSH_KEY_B64
	DEPLOY_KNOWN_HOSTS_B64
)

readonly REQUIRED_CONFIG=(
	EMBED_PORT
	ADMIN_PORT
	EMBED_ALLOWED_ORIGINS
	APP_DIR
	EMBED_DOCROOT
	ADMIN_DOCROOT

	# Every form page carries a submission grant signed with this, so a
	# service without it is a service with no forms rather than a degraded
	# one. It moved out of PENDING when the embedded form landed.
	GRANT_HMAC_KEY
)

# The keys that go to GitHub as *variables* rather than secrets. The hostnames
# are in every snippet on a public website; a port number and a path are not
# worth hiding either, and a variable is readable in a workflow log, which is
# what makes a failing deploy debuggable.
#
# One list, read by both `push` and `check`. Two copies is precisely how a
# drift check stops covering the thing that drifted -- and the drift this
# exists to catch was two of these being stale for weeks.
readonly REPO_VARS=(
	EMBED_HOST
	ADMIN_HOST
	EMBED_PORT
	ADMIN_PORT
	APP_DIR
	EMBED_DOCROOT
	ADMIN_DOCROOT
)

# Warned about rather than refused, so that filling the file in early is
# rewarded and deploying without the whole of it is not blocked.
#
# Some of these now belong to steps that have landed and still degrade to
# something that works: with no SMTP_HOST mail is recorded in the log instead of
# sent, and with no ADMIN_NOTIFY_EMAIL a submission is announced only to the
# form's own notify list and to whoever holds results on it. The warning is the
# point in both cases -- each is a service that looks healthy and tells nobody
# anything.
#
# BOOTSTRAP_SIGNIN_SECRET is deliberately not in this list. Empty is its
# *finished* state rather than an unfilled one: it mints the first session
# without mail, and once there are accounts with backup codes an empty value is
# the right answer, because it leaves the route unmounted. Warning about it
# would train somebody to fill in a guessable way into a founding session.
readonly PENDING=(
	SMTP_HOST
	SMTP_PORT
	SMTP_USER
	SMTP_PASSWORD
	MAIL_FROM
	ADMIN_NOTIFY_EMAIL

	# Taking payment. Both are empty until there is a Stripe account, and that
	# is a working service: a form that sells stores its orders as pending and
	# shows no payment button. render_config below omits the whole [stripe]
	# section while they are empty, because the binary refuses to start on a
	# half-configured payment path.
	#
	# No port and no docroot: the webhook shares the embed listener, at
	# /stripe/webhook, mounted outside its origin gate. See muxer.Embed.
	#
	# STRIPE_PUBLISHABLE_KEY is for the in-page Payment Element, which is
	# Track B. Nothing reads it yet.
	STRIPE_SECRET_KEY
	STRIPE_PUBLISHABLE_KEY
	STRIPE_WEBHOOK_SECRET
)

load() {
	[ -f "$ENV_FILE" ] || die "$ENV_FILE does not exist. Copy secrets.env.example to secrets.env and fill it in."

	# A mode check, because this file is the whole of the service's secrets and
	# the account it lives in is shared with other sites.
	local mode
	mode=$(stat -c '%a' "$ENV_FILE" 2>/dev/null || stat -f '%Lp' "$ENV_FILE" 2>/dev/null || echo unknown)
	case "$mode" in
	600 | 400) ;;
	unknown) ;;
	*) warn "$ENV_FILE is mode $mode; run: chmod 600 $ENV_FILE" ;;
	esac

	set -a
	# shellcheck disable=SC1090
	. "$ENV_FILE"
	set +a
}

# missing prints the names of the empty or unset keys among its arguments.
missing() {
	local key
	for key in "$@"; do
		if [ -z "${!key:-}" ]; then
			printf '%s\n' "$key"
		fi
	done
}

# absent prints the keys that have no line in the file at all, as distinct from
# the ones that have a line and no value.
#
# The distinction is the whole reason these are two functions. A key with a
# blank value is something you have not filled in yet; a key with no line is a
# secrets.env copied from an older secrets.env.example, which is what happens
# every time this list grows. Reporting the second as "empty" sends somebody
# looking for a value they never had a line to put.
absent() {
	local key
	for key in "$@"; do
		grep -q "^$key=" "$ENV_FILE" || printf '%s\n' "$key"
	done
}

# blank prints the keys that have a line and no value.
blank() {
	local key
	for key in "$@"; do
		if grep -q "^$key=" "$ENV_FILE" && [ -z "${!key:-}" ]; then
			printf '%s\n' "$key"
		fi
	done
}

# drift compares this file against what GitHub Actions will actually deploy
# with, and reports every difference.
#
# It exists because of a real failure. EMBED_PORT and ADMIN_PORT were changed
# here when 8410 turned out to be held by another account on the shared host,
# `secrets.env` was right, the server was right, and the GitHub variables went
# on saying 8410 and 8411 for weeks. The first CD run refused -- correctly, at
# the .htaccess port check, before touching anything -- but nothing had been
# able to say so in advance, and the way you found out was a red deploy.
#
# Variables only, and that limitation is worth stating plainly rather than
# papering over: GitHub will not give back a secret's value, by design, so a
# changed DEPLOY_SSH_* value is invisible from here. This reports that those
# secrets *exist*, and says the rest out loud.
#
# Prints values, which is safe for exactly these keys: they are repository
# variables, which any workflow log shows in full. Nothing from
# REQUIRED_DEPLOY is ever printed.
drift() {
	# Not having gh, or not being signed in, is not a failure. This runs on a
	# machine that may never deploy, and `check`'s job is to answer about this
	# file first.
	if ! command -v gh >/dev/null 2>&1; then
		warn "gh is not installed, so this cannot check what GitHub Actions would deploy with"

		return 0
	fi
	if ! gh auth status >/dev/null 2>&1; then
		warn "gh is not signed in, so this cannot check what GitHub Actions would deploy with"

		return 0
	fi

	local listed
	if ! listed=$(gh variable list --json name,value --jq '.[]|"\(.name)=\(.value)"' 2>/dev/null); then
		warn "could not read this repository's Actions variables; skipping the CD comparison"

		return 0
	fi

	local var here there stale="" unset_there=""
	for var in "${REPO_VARS[@]}"; do
		here="${!var:-}"
		[ -n "$here" ] || continue

		# Matched on the exact name, so a variable whose name is a prefix of
		# another cannot answer for it.
		if ! grep -q "^$var=" <<<"$listed"; then
			unset_there="$unset_there $var"

			continue
		fi

		there=$(grep "^$var=" <<<"$listed" | head -1 | cut -d= -f2-)
		if [ "$here" != "$there" ]; then
			stale="$stale$var|$here|$there
"
		fi
	done

	if [ -n "$unset_there" ]; then
		printf '\033[31mxx\033[0m GitHub Actions has no variable for these, so a pushed deploy will refuse:\n' >&2
		printf '      %s\n' $unset_there >&2
	fi

	if [ -n "$stale" ]; then
		printf '\033[31mxx\033[0m GitHub Actions would deploy with different values than this file:\n' >&2
		printf '%s' "$stale" | while IFS='|' read -r name mine theirs; do
			[ -n "$name" ] || continue
			printf '      %-14s here %-42s GitHub %s\n' "$name" "$mine" "$theirs" >&2
		done
	fi

	if [ -n "$unset_there$stale" ]; then
		printf '   Run: make secrets-push\n' >&2

		return 1
	fi

	# The secrets. Existence is all GitHub will answer, so that is all this
	# claims.
	local listed_secrets missing_secrets="" key
	if listed_secrets=$(gh secret list --json name --jq '.[].name' 2>/dev/null); then
		for key in "${REQUIRED_DEPLOY[@]}"; do
			grep -qx "$key" <<<"$listed_secrets" || missing_secrets="$missing_secrets $key"
		done

		if [ -n "$missing_secrets" ]; then
			printf '\033[31mxx\033[0m GitHub Actions has no secret for these:\n' >&2
			printf '      %s\n' $missing_secrets >&2
			printf '   Run: make secrets-push\n' >&2

			return 1
		fi
	fi

	log "GitHub Actions would deploy with the same values as $ENV_FILE"
	log "(variable values compared exactly; secret values cannot be read back,"
	log " so after changing a DEPLOY_SSH_* value run: make secrets-push)"

	return 0
}

cmd_check() {
	load

	local required=("${REQUIRED_DEPLOY[@]}" "${REQUIRED_CONFIG[@]}")
	local gone_absent gone_blank
	gone_absent=$(absent "${required[@]}")
	gone_blank=$(blank "${required[@]}")

	if [ -n "$gone_absent" ]; then
		printf '\033[31mxx\033[0m %s has no line for these at all:\n' "$ENV_FILE" >&2
		printf '      %s\n' $gone_absent >&2
		printf '   Your copy predates them. Append the matching blocks from\n' >&2
		printf '   secrets.env.example, which documents what each one is for.\n' >&2
	fi

	if [ -n "$gone_blank" ]; then
		printf '\033[31mxx\033[0m these keys in %s have a line and no value:\n' "$ENV_FILE" >&2
		printf '      %s\n' $gone_blank >&2
	fi

	[ -z "$gone_absent$gone_blank" ] || exit 1

	# A key the file has never heard of is almost always a rename this copy has
	# not caught up with, so it is worth saying rather than ignoring.
	local stale
	stale=$(absent "${PENDING[@]}")
	if [ -n "$stale" ]; then
		warn "no line yet for these, which later steps will want:"
		printf '      %s\n' $stale >&2
	fi

	local later
	later=$(blank "${PENDING[@]}")
	if [ -n "$later" ]; then
		warn "not needed yet, but will be:"
		printf '      %s\n' $later >&2
	fi

	log "every key this version needs is present in $ENV_FILE"

	# And then the other half of the question, which is not about this file:
	# would a pushed deploy use these values? Last, so that a missing key here
	# is reported before a comparison that depends on it.
	drift || exit 1
}

cmd_push() {
	load
	command -v gh >/dev/null || die "the GitHub CLI is not installed; see https://cli.github.com"
	gh auth status >/dev/null 2>&1 || die "gh is not signed in; run: gh auth login"

	local gone
	gone=$(missing "${REQUIRED_DEPLOY[@]}")
	[ -z "$gone" ] || {
		printf '\033[31mxx\033[0m cannot push, these are empty:\n' >&2
		printf '      %s\n' $gone >&2
		exit 1
	}

	# Only the deploy group, one key at a time.
	#
	# `gh secret set` has an --env-file flag that would read a dotenv file in
	# one call, and using it here would be a mistake: secrets.env holds the
	# Stripe and SMTP credentials too, and the whole point of this split is
	# that those never reach GitHub. Naming each key is what keeps that true.
	#
	# The value goes in on standard input rather than --body, so it never
	# appears in this process's argument list, which is world-readable in
	# /proc while the command runs. printf '%s' rather than echo, because a
	# trailing newline inside a base64 blob is a key that decodes to garbage.
	local key
	for key in "${REQUIRED_DEPLOY[@]}"; do
		printf '%s' "${!key}" | gh secret set "$key" >/dev/null
		log "set repository secret $key"
	done

	# Variables rather than secrets -- see REPO_VARS. Nothing in this loop
	# would matter if it leaked; everything in the loop above would.
	local var
	for var in "${REPO_VARS[@]}"; do
		if [ -n "${!var:-}" ]; then
			printf '%s' "${!var}" | gh variable set "$var" >/dev/null
			log "set repository variable $var = ${!var}"
		fi
	done
}

# b64 encodes stdin to one line. GNU base64 has -w0 and BSD base64 does not, so
# the newlines come off with tr instead.
b64() { base64 | tr -d '\n'; }

# set_in_env replaces one key's value in place, so a private key never passes
# through a clipboard or a shell history entry.
#
# The sed delimiter is | because base64's alphabet is A-Za-z0-9+/= -- it
# contains / , which would end a s/// expression, and contains neither | nor
# the & that is special on the replacement side.
set_in_env() {
	local key=$1 value=$2

	grep -q "^$key=" "$ENV_FILE" || die "$ENV_FILE has no $key= line to fill in"
	sed -i.bak "s|^$key=.*|$key=$value|" "$ENV_FILE"
	rm -f "$ENV_FILE.bak"
}

# cmd_keygen mints the deploy key and pins the host key.
#
# Two values, and confusing them is the mistake worth designing out:
#
#   DEPLOY_SSH_KEY_B64      the PRIVATE key. The .pub is what goes on the
#                           server; putting it here instead fails at the first
#                           deploy with a permission denied that looks like a
#                           server problem.
#   DEPLOY_KNOWN_HOSTS_B64  the server's host key, so nothing ever needs
#                           StrictHostKeyChecking=no.
#
# The host-key step is trust on first use: whatever ssh-keyscan answers now is
# what every future deploy will insist on. Run it from a network you trust, and
# if it ever changes afterwards the deploy stops rather than shrugging.
cmd_keygen() {
	load
	require_keygen_config

	local keyfile="${DEPLOY_KEY_FILE:-$HOME/.ssh/dropin-forms-deploy}"

	if [ -f "$keyfile" ]; then
		log "reusing the existing key at $keyfile"
	else
		log "generating $keyfile"
		ssh-keygen -t ed25519 -f "$keyfile" -C dropin-forms-cd -N '' >/dev/null
	fi

	log "pinning the host key of $DEPLOY_SSH_HOST port $DEPLOY_SSH_PORT"
	local known
	known=$(ssh-keyscan -p "$DEPLOY_SSH_PORT" -t ed25519 "$DEPLOY_SSH_HOST" 2>/dev/null || true)
	[ -n "$known" ] || die "ssh-keyscan got nothing back from $DEPLOY_SSH_HOST port $DEPLOY_SSH_PORT. Check the host and port, and that you can reach it."

	set_in_env DEPLOY_SSH_KEY_B64 "$(b64 <"$keyfile")"
	set_in_env DEPLOY_KNOWN_HOSTS_B64 "$(printf '%s\n' "$known" | b64)"

	log "filled DEPLOY_SSH_KEY_B64 and DEPLOY_KNOWN_HOSTS_B64 in $ENV_FILE"
	echo
	echo "Now authorise the PUBLIC half on the server:"
	echo
	echo "    ssh -p $DEPLOY_SSH_PORT $DEPLOY_SSH_USER@$DEPLOY_SSH_HOST \\"
	echo "        'mkdir -p ~/.ssh && chmod 700 ~/.ssh && cat >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys' \\"
	echo "        < $keyfile.pub"
	echo
	echo "then check it works without a password:"
	echo
	echo "    ssh -i $keyfile -o IdentitiesOnly=yes -p $DEPLOY_SSH_PORT $DEPLOY_SSH_USER@$DEPLOY_SSH_HOST true"
}

require_keygen_config() {
	local gone
	gone=$(missing DEPLOY_SSH_HOST DEPLOY_SSH_USER DEPLOY_SSH_PORT)
	[ -z "$gone" ] || {
		printf '\033[31mxx\033[0m fill these in first, they say which server to pin:\n' >&2
		printf '      %s\n' $gone >&2
		exit 1
	}
}

# render_config writes the config.toml the server will run with.
#
# It must stay in step with the config struct in cmd/dropin-forms/config.go,
# which refuses to start on a key it does not understand. That strictness is
# deliberate -- a typo in a config file is otherwise silent, because the value
# you meant to set keeps its default -- and it means a section added here
# before the code that reads it will stop the service. Add both together.
# require_test_keys refuses test mode when there are no test keys to use.
#
# Separate from the pair check inside render_config, which asks whether a
# half-filled pair is being rendered. This asks whether the mode makes sense
# at all, and answers before anything is built or sent -- with the sentence
# that says where those keys come from, because a secrets.env written before
# this existed has no line for them.
require_test_keys() {
	[ "$MODE" = test ] || return 0

	local gone
	gone=$(missing STRIPE_TEST_SECRET_KEY STRIPE_TEST_WEBHOOK_SECRET | tr "\\n" " ")
	[ -z "$gone" ] || die "test mode needs these, and they are empty or absent: ${gone% }. They are the sandbox keys, kept beside the live ones so a rehearsal is not an edit; see the STRIPE_TEST_ block in secrets.env.example."

	log "test mode: the config will use STRIPE_TEST_* -- no real card will be charged"
}

render_config() {
	local origins=""
	local o
	for o in $EMBED_ALLOWED_ORIGINS; do
		origins+="\"$o\", "
	done
	origins="${origins%, }"

	# Which pair of Stripe keys goes in, decided by MODE.
	#
	# In the default mode it is the STRIPE_* keys, which are whatever the
	# service is meant to run on. In test mode it is STRIPE_TEST_*, which
	# exist so that a rehearsal on the real page does not mean fetching the
	# sandbox keys out of the dashboard again and pasting them over the live
	# ones -- the edit that is easy to leave half done.
	#
	# Indirection rather than two copies of the section below, because two
	# copies is how the modes come to differ in something other than the keys.
	local key_name=STRIPE_SECRET_KEY hook_name=STRIPE_WEBHOOK_SECRET
	if [ "$MODE" = test ]; then
		key_name=STRIPE_TEST_SECRET_KEY hook_name=STRIPE_TEST_WEBHOOK_SECRET
	fi

	# The [stripe] section is written only when there is something to write.
	#
	# That is not tidiness. The binary refuses to start on a half-configured
	# payment path -- a key with no webhook secret means money collected and
	# no order ever marked paid, and nothing anywhere would say so -- so a
	# section rendered with empty values would stop the service on the next
	# deploy rather than leave payments switched off.
	#
	# Which also means the two stand or fall together here, and a missing
	# port or docroot is refused rather than rendered as an empty addr.
	local stripe=""
	if [ -n "${!key_name:-}" ] || [ -n "${!hook_name:-}" ]; then
		local gone
		gone=$(missing "$key_name" "$hook_name" | tr "\\n" " ")
		[ -z "$gone" ] || die "Stripe is partly configured, and this is still empty: ${gone% }. Both are needed: a key with no webhook secret means money collected and no order ever marked paid."

		# Only in test mode, and only this direction. A live key in the test
		# slot would charge real cards during a rehearsal, and that slot has
		# exactly one meaning. The other direction is deliberately not checked:
		# the STRIPE_* keys are whatever this installation runs on, which was
		# test keys until the day it went live, and the binary itself reports
		# which it got -- `payments LIVE: real cards will be charged` or
		# `payments test mode` -- on startup and in -check.
		if [ "$MODE" = test ] && [ "${!key_name#sk_test_}" = "${!key_name}" ]; then
			die "$key_name does not begin sk_test_, so it is not a sandbox key. Test mode exists to charge nobody; refusing rather than rendering a config that would."
		fi

		stripe=$(
			cat <<STRIPE

[stripe]
secret_key = "${!key_name}"
webhook_secret = "${!hook_name}"
STRIPE
		)
	fi

	cat <<TOML
# Written by scripts/secrets install. Do not edit on the server -- the next
# install overwrites it. Change secrets.env and run \`make secrets-install\`.

[server]
embed_addr = "127.0.0.1:${EMBED_PORT}"
admin_addr = "127.0.0.1:${ADMIN_PORT}"
admin_base_url = "https://${ADMIN_HOST}"
shutdown_grace = "15s"

[embed]
allowed_origins = [${origins}]
grant_signing_key = "${GRANT_HMAC_KEY}"

# Apache is in front, on the loopback, so the visitor's address only exists in
# a header. True because something is in fact in front; it would be false for
# a process listening publicly, where the header is whatever a stranger sent.
trust_proxy = true

[db]
path = "dropin-forms.db"

[log]
level = "info"
file = ""

[auth]
bootstrap_secret = "${BOOTSTRAP_SIGNIN_SECRET}"
${stripe}
[mail]
host = "${SMTP_HOST}"
port = ${SMTP_PORT}
user = "${SMTP_USER}"
password = "${SMTP_PASSWORD}"
from = "${MAIL_FROM}"
from_name = "Schoenstatt Austin"

# Told about every submission, whatever any form says. A form's own notify list
# and the accounts holding results on it are the other two ways somebody hears;
# this is the installation's own address. Empty is allowed and means those two
# are the only ways.
notify = "${ADMIN_NOTIFY_EMAIL}"
TOML
}

# cmd_render writes the config to stdout and touches nothing.
#
# It exists so that there is a way to see what `install` would send, and so
# that deploy.sh can ship the config alongside the binary instead of the two
# travelling separately. Having only `install` was a trap: the obvious way to
# inspect the rendered config was to run the thing that also uploads it.
cmd_render() {
	load
	require_test_keys

	local gone
	gone=$(missing "${REQUIRED_CONFIG[@]}")
	[ -z "$gone" ] || {
		printf '\033[31mxx\033[0m cannot render, these are empty:\n' >&2
		printf '      %s\n' $gone >&2
		exit 1
	}

	render_config
}

cmd_install() {
	load
	require_test_keys

	local gone
	gone=$(missing "${REQUIRED_DEPLOY[@]}" "${REQUIRED_CONFIG[@]}")
	[ -z "$gone" ] || {
		printf '\033[31mxx\033[0m cannot install, these are empty:\n' >&2
		printf '      %s\n' $gone >&2
		exit 1
	}

	log "sending config.toml to $DEPLOY_SSH_USER@$DEPLOY_SSH_HOST:$APP_DIR/"

	# Written through a shell on the far side rather than scp'd from a local
	# temporary file, so the rendered secrets never touch either disk.
	#
	# It lands as config.toml.new and is NOT moved into place here. The
	# binary already on the server has to accept it first -- see below.
	render_config | ssh -p "$DEPLOY_SSH_PORT" "$DEPLOY_SSH_USER@$DEPLOY_SSH_HOST" \
		"mkdir -p '$APP_DIR' && cat > '$APP_DIR/config.toml.new' && chmod 600 '$APP_DIR/config.toml.new'"

	# The guard that makes this command safe to run on its own.
	#
	# A config and the binary that reads it arrive by different routes, so they
	# can disagree -- and the disagreement is silent: the running process
	# already has its settings in memory and carries on, until something
	# restarts it and it will not start at all, because loadConfig refuses a
	# key it does not recognise. That is right, and it is discovered at the
	# worst possible moment.
	#
	# So the deployed binary is asked, before anything is moved into place.
	log "asking the deployed binary whether it accepts it"

	if ! ssh -p "$DEPLOY_SSH_PORT" "$DEPLOY_SSH_USER@$DEPLOY_SSH_HOST" \
		"cd '$APP_DIR' && [ -x ./$APP ] && ./$APP -config config.toml.new -check"; then

		ssh -p "$DEPLOY_SSH_PORT" "$DEPLOY_SSH_USER@$DEPLOY_SSH_HOST" \
			"rm -f '$APP_DIR/config.toml.new'" || true

		printf '\033[31mxx\033[0m the binary on the server will not accept this config, so nothing was changed.\n' >&2
		printf '      This config needs a newer binary. Deploy them together instead:\n' >&2
		printf '      \033[1mdeploy/deploy.sh deploy\033[0m\n' >&2
		printf '      which ships the binary and the config in one swap and rolls both back together.\n' >&2
		exit 1
	fi

	ssh -p "$DEPLOY_SSH_PORT" "$DEPLOY_SSH_USER@$DEPLOY_SSH_HOST" \
		"cd '$APP_DIR' && mv -f config.toml.new config.toml && ls -l config.toml"

	# And restart, rather than printing the command to restart.
	#
	# The running process holds its settings in memory, so until this happens
	# the config on disk and the service behaviour disagree -- and the way that
	# bites is specific and expensive. The mode switch either side of a
	# rehearsal is two installs, and forgetting the restart after the second
	# one leaves the sandbox keys running on the machine that sells the
	# tickets: every real card is charged in test mode, no money arrives, and
	# every order stays pending with nothing anywhere saying why.
	#
	# There is no flag to skip it. A config staged and not applied is the state
	# this pair of commands kept producing, and an option to produce it
	# deliberately is an option somebody sets by accident.
	log "restarting so the new config is what is running"

	"$REPO_DIR/deploy/deploy.sh" restart
}

# The second word, where there is one, is the mode. Only render and install
# have one, because they are the only two that write a config.
case "${2:-}" in
'') ;;
test) MODE=test ;;
*) die "unknown mode ${2}: render and install take 'test', or nothing for the configured keys." ;;
esac
readonly MODE

case "${1:-check}" in
check) cmd_check ;;
keygen) cmd_keygen ;;
push) cmd_push ;;
render) cmd_render ;;
install) cmd_install ;;
*)
	echo "usage: scripts/secrets [check|keygen|push|render|install] [test]" >&2
	echo >&2
	echo "  check    report which values are missing or blank" >&2
	echo "  keygen   make a deploy key and pin the host key" >&2
	echo "  push     send the deploy group to GitHub" >&2
	echo "  render   print the config this would install, and change nothing" >&2
	echo "  install  send the config to the server, if the binary there accepts" >&2
	echo "           it, and restart so that it is what is running" >&2
	echo >&2
	echo "  render and install take a mode. With none they use the STRIPE_*" >&2
	echo "  keys; with 'test' they use STRIPE_TEST_*, so that a rehearsal on" >&2
	echo "  the real page charges nobody and needs no edit to this file." >&2
	exit 2
	;;
esac
