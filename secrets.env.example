# Every secret this service needs, in one file.
#
# Copy this to `secrets.env`, fill it in, and keep that copy in your password
# vault. `secrets.env` is gitignored by the `*.env` rule; this example is
# tracked and is the documentation. After cloning on a new machine, dropping
# one file in place is the whole of the setup.
#
# It has two destinations, and keeping them apart is the point:
#
#   make secrets-check     parse this file, name every missing or empty key,
#                          print nothing else. Never echoes a value.
#   make secrets-push      the DEPLOY group -> GitHub repository secrets, so CD
#                          can log in and restart a binary.
#   make secrets-install   the RUNTIME group -> config.toml on the server, over
#                          SSH, mode 600.
#
# Runtime secrets deliberately never reach GitHub. Actions needs exactly enough
# to ship a binary; it has no business holding a Stripe live key. If CD is ever
# compromised, the blast radius should stop at "can deploy code", which is bad
# enough without also being "can charge cards".
#
# Generate the two keys we invent ourselves with:
#   openssl rand -base64 48


# ---------------------------------------------------------------------------
# DEPLOY GROUP -> GitHub repository secrets, via `make secrets-push`
# ---------------------------------------------------------------------------

# The Hetzner konsoleH shell account, left blank on purpose.
#
# This repository is public. The hostname is resolvable in DNS anyway, but the
# account name and the non-standard port are not, and together they are most of
# what narrows a brute-force attempt -- so there is no reason for a public
# repository to name the machine that runs the thing. Find them in konsoleH
# under Access > SSH, or in your vault copy of this file.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=

# The deploy key, base64-encoded so this stays a single-line-per-key file that
# a password vault can hold without mangling newlines.
#
#   ssh-keygen -t ed25519 -f ~/.ssh/dropin-forms-deploy -C dropin-forms-cd -N ''
#   base64 -w0 < ~/.ssh/dropin-forms-deploy
#
# Then append the .pub to ~/.ssh/authorized_keys on the server.
#
# Be clear-eyed about this one: on konsoleH there is no root and therefore no
# sudoers entry to narrow the key to a single installer command, the way the
# VPS sibling does. Whoever holds this key has a shell on the account. That is
# accepted deliberately and is the main argument for CD running on a tag rather
# than on every push.
DEPLOY_SSH_KEY_B64=

# Pinned host key, so CD never needs StrictHostKeyChecking=no. Base64 for the
# same reason as above.
#
#   ssh-keyscan -p <port> -t ed25519 <host> | base64 -w0
DEPLOY_KNOWN_HOSTS_B64=


# ---------------------------------------------------------------------------
# RUNTIME GROUP -> config.toml on the server, via `make secrets-install`
# ---------------------------------------------------------------------------

# Stripe. The publishable key is not secret but lives here so that rotating the
# pair is one edit in one place. The webhook secret comes from the endpoint you
# create in the Stripe dashboard, not from the API keys page -- they are
# different things and mixing them up costs an afternoon.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mail. The mailbox is at the zone apex on purpose: Exim on this host rejects
# mail for subdomains of schoenstatt.link, so neither f. nor forms. can send as
# itself. SPF and DKIM already pass for the apex, which matters because a
# magic link in a spam folder means nobody can sign in.
# Blank for the same reason as above, plus one of its own: an address written
# out in a public repository is an address that gets scraped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Where a new submission is announced, in addition to every account holding the
# `results` role on that form.
ADMIN_NOTIFY_EMAIL=

# Signs the submission grant: the HMAC over form id, form version, nonce and
# expiry that pins server-chosen state into a public POST. Rotating it
# invalidates every form page currently open in somebody's browser, which is
# survivable -- they get a fresh grant on reload -- but do not do it while
# tickets are selling.
GRANT_HMAC_KEY=

# A one-time URL that mints the first session without email, so a mail
# misconfiguration cannot lock you out of your own app. Consumed on first use
# and then inert. Set it, sign in, create your account, and it stops mattering.
BOOTSTRAP_SIGNIN_SECRET=


# ---------------------------------------------------------------------------
# NOT SECRET, but it lives here so one file is the whole configuration
# ---------------------------------------------------------------------------

# Two hostnames, two document roots, two loopback ports. The surface a request
# reached is decided by which socket accepted it, because ProxyPreserveHost
# cannot be set in .htaccess and the proxied Host header is therefore
# 127.0.0.1:<port> for both. See docs/design/drop-in-forms.md section 3.1.
#
# These are not ours to assume: the host is shared, and 8410 turned out to be
# held by another account. `deploy/deploy.sh ports` lists what is free.
EMBED_HOST=f.schoenstatt.link
ADMIN_HOST=forms.schoenstatt.link
EMBED_PORT=8412
ADMIN_PORT=8413

# Who may frame an embedded form, space separated, until each form carries its
# own list. This becomes the CSP frame-ancestors directive, so an empty value
# means nothing may frame anything -- the policy fails closed on purpose. A
# list rather than one value because frame-ancestors checks *every* ancestor,
# not just the immediate parent, and Squarespace nests pages inside editor
# chrome.
EMBED_ALLOWED_ORIGINS="https://schoenstatt-austin.us"

# How many database backups to keep on the server. They are taken on every
# deploy, while the writer is stopped.
KEEP_BACKUPS=14

# Paths are relative to the remote home. Do not write a leading `~` here: an
# unquoted assignment is tilde-expanded by your *local* shell, and the server
# is then sent an absolute path under your own home directory that means
# nothing there.
APP_DIR=dropin-forms
EMBED_DOCROOT=public_html/f.schoenstatt.link/public
ADMIN_DOCROOT=public_html/forms.schoenstatt.link/public

# Everything in this last section except the origins list is pushed to GitHub
# as a repository *variable* rather than a secret, by `make secrets-push`. A
# variable is readable in a workflow log, which is right for a port number and
# a path and would be wrong for a key.
